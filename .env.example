# Copy to .env for local overrides. Every value below is the default used when
# the variable is unset or empty, so a .env file is optional for local dev.

# API listen port
PORT=3000

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Temporal frontend address, namespace, and task queue (shared by API client and worker)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Base URL the worker's activities use to reach the mock supplier endpoints
# (served by the API process; e.g. http://api:3000 inside docker compose)
SUPPLIER_BASE_URL=http://localhost:3000

# Redis cache TTL when both suppliers succeeded / when any supplier failed.
# PARTIAL_CACHE_TTL_SECONDS must be <= CACHE_TTL_SECONDS.
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Force the mock supplier endpoints to return 500 ("true" or "1" = on).
# Set these on the API container, not the worker.
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
