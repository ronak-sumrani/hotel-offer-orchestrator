# Local env: config.ts loads ./.env if present, so it must never reach the image.
.env
.env.*
!.env.example

# Dependencies / build output (rebuilt inside the image)
node_modules
dist
coverage
*.log

# VCS / editor / assistant
.git
.gitignore
.gitattributes
.claude
.vscode
.idea

# Tests and dev-only scripts
tests
scripts
vitest.config.*

# Docker / docs / misc (not needed to build or run)
Dockerfile
.dockerignore
docker-compose*.yml
compose*.yml
README.md
CLAUDE.md
push-both.sh
postman_collection.json
*.postman_collection.json
