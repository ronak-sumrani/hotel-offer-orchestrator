{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel offer orchestrator: Express API + Temporal worker + Redis",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts | pino-pretty",
    "dev:worker": "tsx watch src/temporal/worker.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json && node dist/temporal/bundleWorkflows.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "typecheck": "tsc --noEmit",
    "workflow:run": "tsx scripts/runWorkflow.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
